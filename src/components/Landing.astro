---
import img_1 from '../assets/img_1.png'
import img_2 from '../assets/img_2.png'
import img_3 from '../assets/img_3.png'
import texture from '../assets/texture.jpg'
import photograph from '../assets/photograph_1.jpg'
import { Image } from 'astro:assets';
import "@fontsource/instrument-serif";
import "@fontsource/inter";
import "@fontsource/inter/700.css"; 
---
<div class="wrapper" id="home-section-redirect">
    <!-- navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <h2>Jacob M.</h2>
            <input type="checkbox" id="menu-toggle" class="menu-toggle" style="display: none;">
            <label for="menu-toggle" class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <ul class="navbar-menu">
                <li><a href="#home-section-redirect">Home</a></li>
                <li><a href="#skills-section-redirect">Skills</a></li>
                <li><a href="">Contacts</a></li>
            </ul>
        </div>
    </nav>
    <!--  -->
    <main>
        <div class="sections">
            <!-- first page -->
            <div class="section-1">
                <div class="section-1-1">
                    <div class="intro-1">
                        <h4 id="hi"><b>Hi!&nbsp;</b></h4>
                        <h4><b>I'm</b></h4>
                    </div>
                    <div class="something-burger">
                        <span id="name">Jacob</span>
                        <div class="rect"><Image src={texture} loading="eager" alt="texture" class="texture"/></div>
                        <div class="skills">
                            <p style="text-align: left;">Web Dev</p>
                            <p style="text-align: right;">Photographer</p>
                        </div>
                    </div>
                </div>
                <div class="section-1-2">
                    <Image class="side-img" src={img_1} loading="eager" alt="kid me"/>
                    <Image class="main-img"src={img_2} loading="eager" alt="me"/>
                    <Image class="side-img" src={img_3} loading="eager" alt="kid me"/>
                </div>
            </div>
            <!-- second page  -->
            <div class="section-2" id="skills-section-redirect">
                    <div class="section-2-1">
                        <div class="text">
                            <h1 class="xl-title">Skills</h1>
                            <h2>Photography</h2>
                            <p>Two years of capturing expression and meaning through the medium of photography. What started off as youth ministry&mdash;became my lifelong endeavor.</p>
                        </div>
                        <div class="partition"></div>
                        <Image src={photograph} loading="lazy" alt="photograph by me"/>
                    </div>

                    <div class="section-2-2">
                    </div>
            </div>
        </div>
    </main>
</div>